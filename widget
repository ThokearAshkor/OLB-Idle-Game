// Minimal item pool for widget drops
const W_ITEMS = [
  { id:'round_stone', rarity:'common'   },{ id:'old_coin',    rarity:'common'   },
  { id:'crow_feather',rarity:'common'   },{ id:'river_mud',   rarity:'common'   },
  { id:'bent_nail',   rarity:'common'   },{ id:'dried_flower',rarity:'common'   },
  { id:'smooth_glass',rarity:'common'   },{ id:'brass_button',rarity:'common'   },
  { id:'acorn_cap',   rarity:'common'   },{ id:'knot_of_rope',rarity:'common'   },
  { id:'odd_root',    rarity:'uncommon' },{ id:'warm_stone',  rarity:'uncommon' },
  { id:'letter',      rarity:'uncommon' },{ id:'worn_map',    rarity:'uncommon' },
  { id:'bone_dice',   rarity:'uncommon' },{ id:'worn_boot',   rarity:'uncommon' },
  { id:'folded_note', rarity:'uncommon' },{ id:'black_ribbon',rarity:'uncommon' },
  { id:'compass',     rarity:'rare'     },{ id:'glass_eye',   rarity:'rare'     },
  { id:'silver_key',  rarity:'rare'     },{ id:'singing_stone',rarity:'rare'    },
  { id:'ink_vial',    rarity:'rare'     },{ id:'old_crown',   rarity:'rare'     },
  { id:'road_ghost',  rarity:'rare'     },{ id:'frozen_watch',rarity:'rare'     },
  { id:'small_door',  rarity:'rare'     },{ id:'named_stone', rarity:'rare'     },
  { id:'lantern_dark',rarity:'rare'     },{ id:'echo_stone',  rarity:'rare'     },
  { id:'road_coin',   rarity:'rare'     },
];

function tryItemDrop(state, skills) {
  const rareBoost = skills.has('rare_rate_up') ? 3 : 1;
  const pool = W_ITEMS.map(i => ({
    ...i,
    weight: i.rarity==='common' ? 10 : i.rarity==='uncommon' ? 4 : 1*rareBoost
  }));
  const item = weightedPick(pool);
  const expGain = item.rarity==='common' ? 5 : item.rarity==='uncommon' ? 20 : 80;
  state.collection = state.collection || {};
  state.collection[item.id] = (state.collection[item.id]||0) + 1;
  state.itemsFound = (state.itemsFound||0) + 1;
  gainExp(state, skills, expGain);
}

// ── Milestone tracking ────────────────────────────────
const STEP_MILESTONES = [100,500,1000,5000,10000,25000,50000,100000];

function checkMilestone(state, skills, lastMilestone) {
  let lm = lastMilestone;
  for (const m of STEP_MILESTONES) {
    if (state.steps >= m && lm < m) {
      lm = m;
      gainExp(state, skills, m >= 10000 ? 200 : m >= 1000 ? 50 : 10);
    }
  }
  return lm;
}

// ── Apply rewards ─────────────────────────────────────
function applyRewards(state, skills, rewards, affinity) {
  let expAmt = rewards.exp || 0;
  if (affinity==='arcane' && skills.has('arcane_exp')) expAmt = Math.round(expAmt*1.5);
  if (affinity==='social' && skills.has('social_exp')) expAmt = Math.round(expAmt*1.3);
  if (skills.has('exp_windfall') && Math.random()<0.15) expAmt *= 2;
  if (expAmt) gainExp(state, skills, expAmt);

  const hpMax = maxHP(state.level)+(skills.has('hp_max_bonus')?40:0);
  const mpMax = maxMP(state.level)+(skills.has('mp_max_bonus')?40:0);
  const spMax = maxSP(state.level)+(skills.has('sp_max_bonus')?50:0);
  if (rewards.hp) state.hp = Math.max(0, Math.min(hpMax, state.hp+rewards.hp));
  if (rewards.mp) state.mp = Math.max(0, Math.min(mpMax, state.mp+rewards.mp));
  if (rewards.sp) state.sp = Math.max(0, Math.min(spMax, state.sp+rewards.sp));
}

// ── Widget UI update ──────────────────────────────────
function updateWidgetUI(state) {
  const lv = state.level;
  const skills = buildSkillSet(state);
  const hpMax  = maxHP(lv)+(skills.has('hp_max_bonus')?40:0);
  const mpMax  = maxMP(lv)+(skills.has('mp_max_bonus')?40:0);
  const spMax  = maxSP(lv)+(skills.has('sp_max_bonus')?50:0);
  const expMax = expToNext(lv);

  // Portrait
  const wImg   = document.getElementById('w-img');
  const wEmoji = document.getElementById('w-emoji');
  if (state.portrait) {
    wImg.src = state.portrait;
    wImg.classList.remove('hidden');
    wEmoji.classList.add('hidden');
  } else {
    wImg.classList.add('hidden');
    wEmoji.classList.remove('hidden');
  }

  document.getElementById('w-name').textContent  = state.name || '—';
  document.getElementById('w-level').textContent = `The Traveler · Lv. ${lv}`;
  document.getElementById('w-title').textContent = `"${state.activeTitle||'First Step'}"`;

  document.getElementById('w-hp-val').textContent = `${fmt(state.hp)} / ${hpMax}`;
  document.getElementById('w-mp-val').textContent = `${fmt(state.mp)} / ${mpMax}`;
  document.getElementById('w-sp-val').textContent = `${fmt(state.sp)} / ${spMax}`;
  document.getElementById('w-exp-val').textContent= `${fmt(state.exp)} / ${expMax}`;
  document.getElementById('w-hp-bar').style.width = pct(state.hp, hpMax);
  document.getElementById('w-mp-bar').style.width = pct(state.mp, mpMax);
  document.getElementById('w-sp-bar').style.width = pct(state.sp, spMax);
  document.getElementById('w-exp-bar').style.width= pct(state.exp, expMax);

  document.getElementById('w-steps').textContent = fmt(state.steps);
  document.getElementById('w-lv').textContent    = lv;
  document.getElementById('w-day').textContent   = state.days || 1;
  document.getElementById('w-items').textContent = state.itemsFound || 0;

  const loc  = LOCATIONS[state.locationIndex] || LOCATIONS[0];
  const next = LOCATIONS[Math.min(state.locationIndex+1, LOCATIONS.length-1)];
  const atEnd = state.locationIndex >= LOCATIONS.length-1;
  document.getElementById('w-loc').textContent       = loc.name;
  document.getElementById('w-path-from').textContent = loc.name;
  document.getElementById('w-path-to').textContent   = atEnd ? '—' : next.name;

  const pathPct = atEnd ? 100 : Math.min(99, (state.locationSteps/loc.stepsNeeded)*100);
  document.getElementById('w-path-fill').style.width = pathPct.toFixed(1)+'%';

  // Status dot + banner
  const dot    = document.getElementById('w-dot');
  const banner = document.getElementById('w-rest-banner');
  const statusTxt = document.getElementById('w-status');
  const rateEl = document.getElementById('w-step-rate');

  if (state.isResting) {
    dot.className = 'widget-dot ' + (state.forcedRest ? 'forced' : 'resting');
    statusTxt.textContent = state.forcedRest ? 'Down' : 'Resting';
    banner.style.display = 'block';
    banner.className = 'widget-rest-banner' + (state.forcedRest ? ' forced' : '');
    banner.textContent = state.forcedRest ? 'Down for the count — resuming at dawn' : 'Resting until morning';
    rateEl.textContent = '— steps / sec';
  } else {
    dot.className = 'widget-dot walking';
    statusTxt.textContent = 'Walking';
    banner.style.display = 'none';
    rateEl.textContent = skills.has('bonus_steps') ? '1+ steps / sec' : '1 step / sec';
  }
}

// ── Widget tick ───────────────────────────────────────
let _wTick = 0;
let _wEventCD = 0;
let _wItemCD  = 0;
let _wLastMile = 0;
let _wInterval = null;

function widgetTick() {
  let state = load();
  if (!state) return;

  const skills  = buildSkillSet(state);
  const resting = shouldRest();

  // Rest transition
  if (resting && !state.isResting) {
    state.isResting  = true;
    state.forcedRest = false;
    state.days       = (state.days||1) + 1;
    if (skills.has('day_bonus')) gainExp(state, skills, state.days * 5);
    const hpMax = maxHP(state.level)+(skills.has('hp_max_bonus')?40:0);
    const mpMax = maxMP(state.level)+(skills.has('mp_max_bonus')?40:0);
    const spMax = maxSP(state.level)+(skills.has('sp_max_bonus')?50:0);
    state.hp = hpMax; state.mp = mpMax; state.sp = spMax;
    save(state); updateWidgetUI(state); return;
  }

  if (!resting && state.isResting) {
    state.isResting  = false;
    state.forcedRest = false;
    save(state); updateWidgetUI(state); return;
  }

  if (state.isResting) { updateWidgetUI(state); return; }

  // ── Walking ───────────────────────────────────────
  _wTick++;
  state.steps         = (state.steps||0) + 1;
  state.locationSteps = (state.locationSteps||0) + 1;
  gainExp(state, skills, 1);

  // SP regen
  const spMax = maxSP(state.level)+(skills.has('sp_max_bonus')?50:0);
  const spRegen = skills.has('sure_footed') ? 0.1 : 0.05;
  state.sp = Math.min(spMax, state.sp+spRegen);

  // HP regen
  if (skills.has('hp_regen')) {
    const hpMax = maxHP(state.level)+(skills.has('hp_max_bonus')?40:0);
    state.hp = Math.min(hpMax, state.hp+0.02);
  }

  // Iron Stride
  if (skills.has('bonus_steps') && _wTick%5===0 && state.sp>=spMax) {
    state.steps++; state.locationSteps++; gainExp(state, skills, 1);
  }

  // Golden Mile
  if (skills.has('mile_bonus') && state.steps%500===0 && Math.random()<0.3) {
    tryItemDrop(state, skills);
  }

  _wLastMile = checkMilestone(state, skills, _wLastMile);
  checkLocation(state, skills);
  checkSkills(state);
  checkTitles(state);

  // Event
  _wEventCD--;
  if (_wEventCD <= 0) {
    const ev = weightedPick(W_EVENTS);
    state.affinities = state.affinities || {};
    state.affinities[ev.affinity] = (state.affinities[ev.affinity]||0) + 1;
    const rewards = ev.rewards();
    applyRewards(state, skills, rewards, ev.affinity);
    state.eventsFound = (state.eventsFound||0) + 1;

    // Beast-Familiar
    if (ev.affinity==='nature' && skills.has('beast_heal')) {
      const hpMax = maxHP(state.level)+(skills.has('hp_max_bonus')?40:0);
      state.hp = Math.min(hpMax, state.hp+10);
      state.sp = Math.min(spMax, state.sp+15);
    }

    // Re-check skills after affinity update
    checkSkills(state);

    // 0 HP forced rest
    if (state.hp <= 0) {
      state.hp = 0;
      state.isResting  = true;
      state.forcedRest = true;
      state.forcedRests = (state.forcedRests||0) + 1;
      state.days = (state.days||1) + 1;
      const hpMax = maxHP(state.level)+(skills.has('hp_max_bonus')?40:0);
      state.hp = Math.floor(hpMax * 0.5);
      state.mp = maxMP(state.level)+(skills.has('mp_max_bonus')?40:0);
      state.sp = spMax;
      checkTitles(state);
      save(state); updateWidgetUI(state); return;
    }

    const socialMod = skills.has('social_freq') ? 0.8 : 1;
    const arcaneMod = skills.has('arcane_freq') ? 0.8 : 1;
    _wEventCD = Math.round((45+Math.random()*45)*Math.min(socialMod,arcaneMod));
  }

  // Item drop
  _wItemCD--;
  if (_wItemCD <= 0) {
    const rateBoost = skills.has('item_rate_up') ? 0.75 : 1;
    _wItemCD = Math.round((120+Math.random()*120)*rateBoost);
    tryItemDrop(state, skills);
  }

  if (_wTick%30===0) save(state);
  updateWidgetUI(state);
}

// ── Init ─────────────────────────────────────────────
(function init() {
  const state = load();

  if (!state) {
    document.getElementById('w-nosave').classList.remove('hidden');
    document.getElementById('w-game').classList.add('hidden');
    return;
  }

  // Restore milestone tracker
  _wLastMile = 0;
  for (const m of [100,500,1000,5000,10000,25000,50000,100000]) {
    if (state.steps >= m) _wLastMile = m;
  }

  // Stagger cooldowns so widget doesn't spam on load
  _wEventCD = 20 + Math.floor(Math.random()*20);
  _wItemCD  = 40 + Math.floor(Math.random()*40);

  document.getElementById('w-nosave').classList.add('hidden');
  document.getElementById('w-game').classList.remove('hidden');

  updateWidgetUI(state);

  if (_wInterval) clearInterval(_wInterval);
  _wInterval = setInterval(widgetTick, 1000);
})();
</script>
