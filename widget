<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Long Road — Widget</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,600;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --parchment:      #EFE6D3;
    --parchment-mid:  #E2D5BC;
    --parchment-deep: #D0BF9E;
    --ink:            #3A3226;
    --ink-faded:      #6B5E4E;
    --ink-ghost:      #9A8C7C;
    --leather:        #8B6F47;
    --leather-light:  #C4A97D;
    --moss:           #6B7F5E;
    --moss-light:     #E8EDE5;
    --wax:            #A8431F;
    --wax-light:      #F4E8E3;
    --blue:           #5B7FA6;
    --blue-light:     #E8EEF4;

    --font-display: 'Spectral', Georgia, serif;
    --font-body:    'Source Serif 4', Georgia, serif;
    --font-data:    'JetBrains Mono', monospace;
  }

  html, body {
    background: transparent;
}

.widget {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--ink);
    line-height: 1.5;
}

  /* ── Widget card ───────────────────────────────────── */
  .widget {
    background: var(--parchment);
    border: 2px solid var(--leather);
    border-radius: 6px;
    overflow: hidden;
    width: 100%;
    max-width: 240px;
    font-family: var(--font-body);
  }

  /* Header */
  .widget-header {
    background: var(--ink);
    padding: 8px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px solid var(--leather);
  }

  .widget-wordmark {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    color: var(--parchment);
    letter-spacing: 0.03em;
  }

  .widget-wordmark span { color: var(--leather-light); }

  .widget-status {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .widget-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--moss);
    flex-shrink: 0;
  }

  .widget-dot.walking { animation: pulse 2s ease-in-out infinite; }
  .widget-dot.resting { background: var(--blue); animation: none; }
  .widget-dot.forced  { background: #C0604A; animation: none; }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.3; }
  }

  .widget-status-txt {
    font-family: var(--font-data);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-ghost);
  }

  /* Character block */
  .widget-char {
    padding: 12px 12px 10px;
    display: flex;
    gap: 10px;
    align-items: center;
    border-bottom: 1px solid var(--parchment-deep);
    background: var(--parchment-mid);
  }

  .widget-portrait {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid var(--leather);
    background: var(--parchment-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  .widget-portrait-emoji { font-size: 20px; line-height: 1; }
  .widget-portrait-img   { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; display: block; }

  .widget-char-info { flex: 1; min-width: 0; }

  .widget-char-name {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .widget-char-level {
    font-family: var(--font-data);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-ghost);
    margin-top: 1px;
  }

  .widget-char-title {
    font-family: var(--font-body);
    font-size: 11px;
    font-style: italic;
    color: var(--wax);
    margin-top: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Stat bars */
  .widget-stats {
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-bottom: 1px solid var(--parchment-deep);
  }

  .widget-stat {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .widget-stat-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .widget-stat-name {
    font-family: var(--font-data);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-ghost);
  }

  .widget-stat-val {
    font-family: var(--font-data);
    font-size: 9px;
    color: var(--ink-faded);
  }

  .widget-bar-track {
    height: 4px;
    background: var(--parchment-deep);
    border-radius: 2px;
    overflow: hidden;
  }

  .widget-bar-fill {
    height: 100%;
    border-radius: 2px;
    transition: width 0.6s ease;
  }

  .bar-hp  { background: var(--wax); }
  .bar-mp  { background: var(--blue); }
  .bar-sp  { background: var(--moss); }
  .bar-exp { background: var(--leather-light); }

  /* Journey stats row */
  .widget-journey {
    padding: 8px 12px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    border-bottom: 1px solid var(--parchment-deep);
  }

  .widget-journey-tile {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .widget-journey-label {
    font-family: var(--font-data);
    font-size: 8px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-ghost);
  }

  .widget-journey-val {
    font-family: var(--font-data);
    font-size: 12px;
    font-weight: 500;
    color: var(--ink);
  }

  /* Location */
  .widget-location {
    padding: 8px 12px;
    border-bottom: 1px solid var(--parchment-deep);
  }

  .widget-loc-eyebrow {
    font-family: var(--font-data);
    font-size: 8px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--moss);
    margin-bottom: 2px;
  }

  .widget-loc-name {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }

  /* Path progress */
  .widget-path {
    padding: 8px 12px;
    border-bottom: 1px solid var(--parchment-deep);
  }

  .widget-path-labels {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4px;
  }

  .widget-path-label {
    font-family: var(--font-data);
    font-size: 8px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-ghost);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 48%;
  }

  .widget-path-track {
    height: 3px;
    background: var(--parchment-deep);
    border-radius: 2px;
    overflow: visible;
    position: relative;
  }

  .widget-path-fill {
    height: 100%;
    background: var(--leather);
    border-radius: 2px;
    position: relative;
    transition: width 0.8s ease;
    min-width: 12px;
  }

  .widget-walker {
    position: absolute;
    right: -7px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 10px;
    line-height: 1;
  }

  /* Footer / open link */
  .widget-footer {
    padding: 8px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--parchment-mid);
  }

  .widget-step-count {
    font-family: var(--font-data);
    font-size: 9px;
    color: var(--ink-ghost);
    letter-spacing: 0.04em;
  }

  .widget-open-link {
    font-family: var(--font-data);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--leather);
    text-decoration: none;
    border: 1px solid var(--leather);
    padding: 3px 8px;
    border-radius: 10px;
    transition: background 0.15s, color 0.15s;
  }

  .widget-open-link:hover {
    background: var(--leather);
    color: var(--parchment);
  }

  /* No-save state */
  .widget-nosave {
    padding: 16px 12px;
    text-align: center;
    font-size: 12px;
    color: var(--ink-ghost);
    font-style: italic;
    line-height: 1.5;
  }

  .widget-nosave a {
    display: inline-block;
    margin-top: 10px;
    font-family: var(--font-data);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--leather);
    text-decoration: none;
    border: 1px solid var(--leather);
    padding: 4px 10px;
    border-radius: 10px;
    transition: background 0.15s, color 0.15s;
  }

  .widget-nosave a:hover {
    background: var(--leather);
    color: var(--parchment);
  }

  /* Rest overlay */
  .widget-rest-banner {
    padding: 6px 12px;
    background: var(--blue-light);
    border-top: 1px solid var(--blue);
    border-bottom: 1px solid var(--blue);
    font-family: var(--font-data);
    font-size: 9px;
    letter-spacing: 0.06em;
    color: var(--blue);
    text-align: center;
    display: none;
  }

  .widget-rest-banner.forced {
    background: var(--wax-light);
    border-color: #C0604A;
    color: #C0604A;
  }
</style>
</head>
<body>

<div class="widget" id="widget">

  <div class="widget-header">
    <div class="widget-wordmark">The <span>Long Road</span></div>
    <div class="widget-status">
      <div class="widget-dot walking" id="w-dot"></div>
      <span class="widget-status-txt" id="w-status">Walking</span>
    </div>
  </div>

  <!-- Shown when no save exists -->
  <div class="widget-nosave hidden" id="w-nosave">
    The road is waiting.<br>Your journey has not begun.
    <br><a href="https://onelastforum.com/pages/the-long-road/" target="_blank">Begin the journey</a>
  </div>

  <!-- Shown when save exists -->
  <div id="w-game">

    <div class="widget-rest-banner" id="w-rest-banner">Resting until morning</div>

    <div class="widget-char">
      <div class="widget-portrait" id="w-portrait">
        <span class="widget-portrait-emoji" id="w-emoji">🧙</span>
        <img class="widget-portrait-img hidden" id="w-img" alt="">
      </div>
      <div class="widget-char-info">
        <div class="widget-char-name"  id="w-name">—</div>
        <div class="widget-char-level" id="w-level">The Traveler · Lv. 1</div>
        <div class="widget-char-title" id="w-title">"First Step"</div>
      </div>
    </div>

    <div class="widget-stats">
      <div class="widget-stat">
        <div class="widget-stat-row">
          <span class="widget-stat-name">HP</span>
          <span class="widget-stat-val" id="w-hp-val">100 / 100</span>
        </div>
        <div class="widget-bar-track"><div class="widget-bar-fill bar-hp" id="w-hp-bar" style="width:100%"></div></div>
      </div>
      <div class="widget-stat">
        <div class="widget-stat-row">
          <span class="widget-stat-name">MP</span>
          <span class="widget-stat-val" id="w-mp-val">50 / 50</span>
        </div>
        <div class="widget-bar-track"><div class="widget-bar-fill bar-mp" id="w-mp-bar" style="width:100%"></div></div>
      </div>
      <div class="widget-stat">
        <div class="widget-stat-row">
          <span class="widget-stat-name">SP</span>
          <span class="widget-stat-val" id="w-sp-val">100 / 100</span>
        </div>
        <div class="widget-bar-track"><div class="widget-bar-fill bar-sp" id="w-sp-bar" style="width:100%"></div></div>
      </div>
      <div class="widget-stat">
        <div class="widget-stat-row">
          <span class="widget-stat-name">EXP</span>
          <span class="widget-stat-val" id="w-exp-val">0 / 100</span>
        </div>
        <div class="widget-bar-track"><div class="widget-bar-fill bar-exp" id="w-exp-bar" style="width:0%"></div></div>
      </div>
    </div>

    <div class="widget-journey">
      <div class="widget-journey-tile">
        <span class="widget-journey-label">Steps</span>
        <span class="widget-journey-val" id="w-steps">0</span>
      </div>
      <div class="widget-journey-tile">
        <span class="widget-journey-label">Level</span>
        <span class="widget-journey-val" id="w-lv">1</span>
      </div>
      <div class="widget-journey-tile">
        <span class="widget-journey-label">Day</span>
        <span class="widget-journey-val" id="w-day">1</span>
      </div>
      <div class="widget-journey-tile">
        <span class="widget-journey-label">Items</span>
        <span class="widget-journey-val" id="w-items">0</span>
      </div>
    </div>

    <div class="widget-location">
      <div class="widget-loc-eyebrow">Now in</div>
      <div class="widget-loc-name" id="w-loc">The First Road</div>
    </div>

    <div class="widget-path">
      <div class="widget-path-labels">
        <span class="widget-path-label" id="w-path-from">The First Road</span>
        <span class="widget-path-label" style="text-align:right" id="w-path-to">Millbrook Crossing</span>
      </div>
      <div class="widget-path-track">
        <div class="widget-path-fill" id="w-path-fill" style="width:0%">
          <span class="widget-walker">🚶</span>
        </div>
      </div>
    </div>

    <div class="widget-footer">
      <span class="widget-step-count" id="w-step-rate">1 step / sec</span>
      <a href="https://onelastforum.com/pages/the-long-road/" target="_blank" class="widget-open-link">Open journal</a>
    </div>

  </div>
</div>

<script>
// ════════════════════════════════════════════════════════
//  THE LONG ROAD — Widget Engine
//  Shares localStorage save key with the main game.
//  Runs its own tick so progress continues on forum pages.
// ════════════════════════════════════════════════════════

const SAVE_KEY  = 'tlr_save_v2';
const REST_HOUR = 22;
const WAKE_HOUR = 9;
const LOG_MAX   = 100;

// ── Scaling (must match main game exactly) ────────────
function expToNext(l) { return Math.round(100 * Math.pow(1.5, l - 1)); }
function maxHP(l) { return 100 + (l - 1) * 20; }
function maxMP(l) { return  50 + (l - 1) * 10; }
function maxSP(l) { return 100 + (l - 1) * 15; }

// ── Locations (must match main game) ─────────────────
const LOCATIONS = [
  { name: 'The First Road',     stepsNeeded: 500   },
  { name: 'Millbrook Crossing', stepsNeeded: 1200  },
  { name: 'The Hollow Road',    stepsNeeded: 2500  },
  { name: 'Greymere Crossing',  stepsNeeded: 4500  },
  { name: 'The Ashfield',       stepsNeeded: 7500  },
  { name: 'Duskwatch Tower',    stepsNeeded: 12000 },
  { name: 'The Sunken Road',    stepsNeeded: 18000 },
  { name: 'The Pale Moors',     stepsNeeded: 27000 },
  { name: 'Thornwall Village',  stepsNeeded: 40000 },
  { name: 'The Wandering Wood', stepsNeeded: 60000 },
];

// ── Minimal skill / affinity data needed for widget ──
// (widget runs the same passive effects as the main game)
const AFFINITY_THRESHOLDS = [3, 8, 16, 28];

const SKILL_EFFECTS = {
  endurance: ['sure_footed','bonus_steps','sp_max_bonus','double_step_exp'],
  luck:      ['item_rate_up','rare_rate_up','exp_windfall','mile_bonus'],
  arcane:    ['arcane_freq','arcane_exp','mp_max_bonus','deep_road_exp'],
  nature:    ['hp_regen','beast_heal','hp_max_bonus','loc_exp'],
  social:    ['social_exp','social_freq','social_items','day_bonus'],
};

// ── Helpers ───────────────────────────────────────────
function fmt(n)    { return Math.floor(n).toLocaleString(); }
function pct(a, b) { return Math.min(100, Math.max(0, (a / b) * 100)).toFixed(1) + '%'; }
function shouldRest() { const h = new Date().getHours(); return h >= REST_HOUR || h < WAKE_HOUR; }
function timeLabel() {
  const now = new Date(); let h = now.getHours(), m = now.getMinutes();
  const ap = h >= 12 ? 'pm' : 'am'; h = h % 12 || 12;
  return `${h}:${String(m).padStart(2,'0')} ${ap}`;
}
function weightedPick(arr) {
  const total = arr.reduce((s,x) => s + (x.weight||1), 0);
  let r = Math.random() * total;
  for (const x of arr) { r -= (x.weight||1); if (r <= 0) return x; }
  return arr[arr.length-1];
}

// ── Persistence ───────────────────────────────────────
function load() {
  try { const r = localStorage.getItem(SAVE_KEY); if (r) return JSON.parse(r); } catch(e) {}
  return null;
}
function save(s) {
  s.lastSaved = Date.now();
  try { localStorage.setItem(SAVE_KEY, JSON.stringify(s)); } catch(e) {}
}

// ── Skill helpers ─────────────────────────────────────
function buildSkillSet(state) {
  const set = new Set(state.skillsUnlocked || []);
  return { has: e => set.has(e) };
}

// ── EXP & levelling ───────────────────────────────────
function gainExp(state, skills, amount) {
  if (skills.has('double_step_exp') && amount === 1) amount = 2;
  state.exp += amount;
  while (state.exp >= expToNext(state.level)) {
    state.exp -= expToNext(state.level);
    state.level++;
    state.hp = maxHP(state.level);
    state.mp = maxMP(state.level);
    state.sp = maxSP(state.level);
  }
}

// ── Check & unlock skills ─────────────────────────────
function checkSkills(state) {
  const unlocked = new Set(state.skillsUnlocked || []);
  for (const [aff, effects] of Object.entries(SKILL_EFFECTS)) {
    const count = (state.affinities || {})[aff] || 0;
    effects.forEach((effect, i) => {
      if (count >= AFFINITY_THRESHOLDS[i] && !unlocked.has(effect)) {
        unlocked.add(effect);
        state.skillsUnlocked = [...unlocked];
        // Apply permanent stat bonuses
        if (effect === 'sp_max_bonus') state.sp = Math.min(maxSP(state.level)+50, state.sp+50);
        if (effect === 'mp_max_bonus') state.mp = Math.min(maxMP(state.level)+40, state.mp+40);
        if (effect === 'hp_max_bonus') state.hp = Math.min(maxHP(state.level)+40, state.hp+40);
      }
    });
  }
}

// ── Check titles ──────────────────────────────────────
// Widget doesn't log title events but does update the earned list
// so the main game reflects them correctly on next open.
function checkTitles(state) {
  // Minimal title conditions mirrored from main game
  const TITLE_CONDITIONS = [
    { id: 'first_step',   label: 'First Step',           check: s => s.steps >= 1 },
    { id: 'hundred',      label: 'The Persistent',        check: s => s.steps >= 100 },
    { id: 'wanderer',     label: 'The Wanderer',          check: s => s.steps >= 500 },
    { id: 'thousand',     label: 'A Thousand Miles',      check: s => s.steps >= 1000 },
    { id: 'tenthousand',  label: 'The Long-Haul',         check: s => s.steps >= 10000 },
    { id: 'collector',    label: 'Finder of Odd Stones',  check: s => s.itemsFound >= 10 },
    { id: 'hoarder',      label: 'The Collector',         check: s => s.itemsFound >= 25 },
    { id: 'seasoned',     label: 'Seasoned Traveler',     check: s => s.days >= 7 },
    { id: 'level5',       label: 'Road-Worn',             check: s => s.level >= 5 },
    { id: 'level10',      label: 'Far-Travelled',         check: s => s.level >= 10 },
    { id: 'level20',      label: 'The Weathered',         check: s => s.level >= 20 },
    { id: 'skilled',      label: 'Marked by the Road',    check: s => (s.skillsUnlocked||[]).length >= 1 },
    { id: 'adept',        label: 'Road-Adept',            check: s => (s.skillsUnlocked||[]).length >= 5 },
    { id: 'master',       label: 'The Road-Touched',      check: s => (s.skillsUnlocked||[]).length >= 10 },
    { id: 'fifty_thou',   label: 'Fifty Thousand Steps',  check: s => s.steps >= 50000 },
    { id: 'hundred_thou', label: 'The Endless',           check: s => s.steps >= 100000 },
    { id: 'level30',      label: 'Deeply Travelled',      check: s => s.level >= 30 },
    { id: 'level50',      label: 'The Inexhaustible',     check: s => s.level >= 50 },
    { id: 'month',        label: 'A Month on the Road',   check: s => s.days >= 30 },
    { id: 'many_things',  label: 'Keeper of Strange Things', check: s => s.itemsFound >= 50 },
    { id: 'down_once',    label: 'What Does Not Kill',    check: s => (s.forcedRests||0) >= 1 },
    { id: 'down_five',    label: 'Hard-Won Miles',        check: s => (s.forcedRests||0) >= 5 },
    { id: 'reach_ashfield',label:'Beyond the Crossing',   check: s => s.locationIndex >= 4 },
    { id: 'reach_moors',  label: 'Walker of Pale Places', check: s => s.locationIndex >= 7 },
    { id: 'reach_wood',   label: 'Into the Wandering Wood', check: s => s.locationIndex >= 9 },
  ];
  const earned = new Set(state.titlesEarned || ['first_step']);
  for (const t of TITLE_CONDITIONS) {
    if (!earned.has(t.id) && t.check(state)) {
      earned.add(t.id);
      state.titlesEarned = [...earned];
      // Auto-update active title to latest earned
      state.activeTitle = t.label;
    }
  }
}

// ── Location progression ──────────────────────────────
function checkLocation(state, skills) {
  const cur = LOCATIONS[state.locationIndex];
  if (!cur) return;
  if (state.locationSteps >= cur.stepsNeeded && state.locationIndex < LOCATIONS.length - 1) {
    state.locationIndex++;
    state.locationSteps = 0;
    let expBonus = 0;
    if (skills.has('loc_exp'))       expBonus += 50;
    if (skills.has('deep_road_exp') && state.locationIndex >= 4) expBonus += 100;
    if (expBonus) gainExp(state, skills, expBonus);
  }
}

// ── Minimal event pool for widget ────────────────────
// Widget fires a simplified event set — enough to drive
// affinity counters and keep stats moving.
// Full flavor text lives in the main game log.
const W_EVENTS = [
